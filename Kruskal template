#include <bits/stdc++.h>
using namespace std;

int n,m;
vector<int>sz(100000),parent(100000);

int find(int a){
    if (parent[a]!=a){
        parent[a]=find(parent[a]);
        
    }
    return parent[a];

}

bool same(int a,int b){
    return find(a)==find(b);

}

void unite(int a,int b){
    a=find(a);
    b=find(b);

    
    if (sz[a]<sz[b]){
        swap(a,b);
    }
    sz[a]+=sz[b];
    parent[b]=a;
}



int main(){

    cin>>n>>m;
    sz.assign(n+1,1);
    parent.assign(n+1,-1);
    priority_queue<tuple<int,int,int>,vector<tuple<int,int,int>>,greater<tuple<int,int,int>>>q;

    for (int i=1;i<n+1;i++){
        parent[i]=i;

    }

    for (int i=0;i<m;i++){
        int a,b,w;
        cin>>a>>b>>w;
        q.push({w,a,b});

    }

    int cost=0;

    for (int i=0;i<m;i++){
        auto [x,y,z]=q.top();

        if (!same(y,z)){
            unite(y,z);
            cost+=x;
        }
        q.pop();
    }
    cout<<cost;


}
