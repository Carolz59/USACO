#include<bits/stdc++.h>
using namespace std;

int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    long long n;
    vector<pair<long long,long long>>v;
    cin>>n;
    for (int i=0;i<n;i++){
        long long s,f;
        cin>>s>>f;
        v.push_back({s,f});

    }
    sort(v.begin(),v.end());

    priority_queue<long long,vector<long long>,greater<long long>>q;
    long long ans=0;

    for (auto [s,f]:v){
        while (!q.empty()&&s>=q.top()){
            q.pop();
        }
        q.push(f);
        ans=max(ans,(long long)q.size());


    }
    cout<<ans<<endl;
    
}
